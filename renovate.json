{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":automergeStableNonMajor"],
  "packageRules": [
    {
      "description": "Use Ofelia's current 0.x.y release scheme",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mcuadros/ofelia"],
      "versioning": "regex:^(?<major>0)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    }
  ]
}
