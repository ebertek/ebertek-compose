{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":automergeStableNonMajor"],
  "packageRules": [
    {
      "allowedVersions": "/^0\\.\\d+\\.\\d+$/",
      "description": "Ignore Ofelia's legacy tags",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mcuadros/ofelia", "docker.io/mcuadros/ofelia"]
    },
    {
      "description": "Update Autoheal Docker image digest weekly",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["willfarrell/autoheal", "docker.io/willfarrell/autoheal"],
      "matchUpdateTypes": ["digest"],
      "schedule": ["* * * * 0"],
      "updateNotScheduled": false
    }
  ]
}
